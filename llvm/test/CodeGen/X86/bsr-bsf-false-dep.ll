; NOTE: Assertions have been autogenerated by utils/update_llc_test_checks.py UTC_ARGS: --version 6
; RUN: llc < %s -mtriple=x86_64-unknown-linux-gnu | FileCheck %s

; bsr and bsf keep the destination register for a zero source, so the CPU reads
; it. With a zero-poison ctlz/cttz the kept value is never used, and a recent
; unrelated write to that register is a false dependency.

define i64 @ctlz64_after_load(ptr %p, ptr %q, i64 %x) nounwind {
; CHECK-LABEL: ctlz64_after_load:
; CHECK:       # %bb.0:
; CHECK-NEXT:    movq (%rsi), %rax
; CHECK-NEXT:    movq %rax, (%rdi)
; CHECK-NEXT:    xorl %eax, %eax
; CHECK-NEXT:    bsrq %rdx, %rax
; CHECK-NEXT:    xorq $63, %rax
; CHECK-NEXT:    retq
  %v = load i64, ptr %q
  store i64 %v, ptr %p
  %r = call i64 @llvm.ctlz.i64(i64 %x, i1 true)
  ret i64 %r
}

