; The source is the destination, so there is no false dependency.
define i64 @ctlz64_src_is_dest() nounwind {
; CHECK-LABEL: ctlz64_src_is_dest:
; CHECK:       # %bb.0:
; CHECK-NEXT:    pushq %rax
; CHECK-NEXT:    callq g@PLT
; CHECK-NEXT:    bsrq %rax, %rax
; CHECK-NEXT:    xorq $63, %rax
; CHECK-NEXT:    popq %rcx
; CHECK-NEXT:    retq
  %x = call i64 @g()
  %r = call i64 @llvm.ctlz.i64(i64 %x, i1 true)
  ret i64 %r
}

; The destination was last written in the previous iteration.
define i64 @ctlz64_loop(ptr %p, i64 %n) nounwind {
; CHECK-LABEL: ctlz64_loop:
; CHECK:       # %bb.0: # %entry
; CHECK-NEXT:    xorl %eax, %eax
; CHECK-NEXT:    .p2align 4
; CHECK-NEXT:  .LBB6_1: # %loop
; CHECK-NEXT:    # =>This Inner Loop Header: Depth=1
; CHECK-NEXT:    xorl %ecx, %ecx
; CHECK-NEXT:    bsrq (%rdi), %rcx
; CHECK-NEXT:    xorq $63, %rcx
; CHECK-NEXT:    addq %rcx, %rax
; CHECK-NEXT:    addq $8, %rdi
; CHECK-NEXT:    decq %rsi
; CHECK-NEXT:    jne .LBB6_1
; CHECK-NEXT:  # %bb.2: # %exit
; CHECK-NEXT:    retq
entry:
  br label %loop

loop:
  %i = phi i64 [ 0, %entry ], [ %i.next, %loop ]
  %acc = phi i64 [ 0, %entry ], [ %acc.next, %loop ]
  %a = getelementptr i64, ptr %p, i64 %i
  %x = load i64, ptr %a
  %c = call i64 @llvm.ctlz.i64(i64 %x, i1 true)
  %acc.next = add i64 %acc, %c
  %i.next = add i64 %i, 1
  %done = icmp eq i64 %i.next, %n
  br i1 %done, label %exit, label %loop

exit:
  ret i64 %acc.next
}

; Registers not written in the function are assumed to have been written long
; ago, so nothing is inserted here.
define i64 @ctlz64_entry(i64 %x) nounwind {
; CHECK-LABEL: ctlz64_entry:
; CHECK:       # %bb.0:
; CHECK-NEXT:    bsrq %rdi, %rax
; CHECK-NEXT:    xorq $63, %rax
; CHECK-NEXT:    retq
  %r = call i64 @llvm.ctlz.i64(i64 %x, i1 true)
  ret i64 %r
}

declare i64 @g()
